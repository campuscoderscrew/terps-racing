<!DOCTYPE html>
<html lang="en">
<!---
	This is the default layout for every page.
	It sets the title based on the page, does some HTML boilerplate, and places the header and footer.
--->

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<script webc:type="js">
		// This is how the title gets set; it uses 11ty's built-in javascript templating
		`<title>Terps Racing | ${title}</title>`
	</script>
</head>

<body>
	<header>Header!</header>
	<div @raw="content"><!-- This is where the content gets slotted. DON'T PUT ANYTHING HERE --></div>
	<footer>Footer!</footer>
</body>

</html>
